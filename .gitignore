!models/checkpoints/fold2/best.pt
!models/checkpoints/fold3/best.pt
!models/checkpoints/fold4/best.pt

# Keep only aggregate NCA result tables and the released patient-level folds.
reports/*
!reports/reproducibility/
!reports/reproducibility/**
splits/*
!splits/ispy2_folds.parquet

# Manuscript files and historical experiment archives stay outside the code release.
manuscript/
archive/
provenance/
notebooks/

