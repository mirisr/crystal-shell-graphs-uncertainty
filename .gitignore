# Retain only model code used by the final NCA pipeline.
lsgc/*
!lsgc/__init__.py
!lsgc/forecaster.py
!lsgc/graph_builder.py
!lsgc/inference.py
!lsgc/lsgc_layer.py
!lsgc/metrics.py
!lsgc/rgcn_layer.py
