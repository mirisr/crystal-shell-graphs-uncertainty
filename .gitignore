experiments/image_to_graph/*
!experiments/image_to_graph/__init__.py
!experiments/image_to_graph/attach_torchvision_patch_embeddings.py
!experiments/image_to_graph/image_crops.py
!experiments/image_to_graph/image_patch_io.py
