!lsgc/tests/test_edge_modes.py
!lsgc/tests/test_forecaster.py
!lsgc/tests/test_image_to_graph.py

# Final checkpoints are small and are part of the NCA release.
runs/
models/*
!models/MODEL_MANIFEST.md
!models/checksums.sha256
!models/checkpoints/
models/checkpoints/*
!models/checkpoints/fold0/
