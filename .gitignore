# Operating-system and editor files
.DS_Store
.idea/
.vscode/
*.code-workspace

# Credentials and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Python build and test artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/

# Local cluster outputs
slurm/
**/logs/
*.out
*.err

# Imaging data and derived tensors. The NCA preprocessing source stays public.
datasets/ispy2/*
!datasets/ispy2/README.md
!datasets/ispy2/scripts/
!datasets/ispy2/scripts/**
datasets/ispy2/scripts/**/__pycache__/
datasets/ispy2/scripts/**/*.py[cod]
datasets/ispy2/scripts/*.sbatch
datasets/ispy2/scripts/*.sh

# Retain only the final NCA experiment implementation.
experiments/*
!experiments/consistent_rollout/
!experiments/image_to_graph/
!experiments/stage1_forecaster/
